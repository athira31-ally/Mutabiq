# Optional Azure AI Vision OCR (falls back to Tesseract)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Detector
YOLO_ONNX_PATH=models/yolov8n_watermark.onnx
DETECT_CONF_THRESHOLD=0.42
PHASH_HAMMING_THRESHOLD=8

# Duplicate index (in-memory default)
DUPLICATE_INDEX_PATH=data/phash_index.json

APP_NAME=trakheesi-compliance-detector
APP_ENV=local
LOG_LEVEL=info

# Pexels -- used to fetch real interior photos for training/demo
PEXELS_API_KEY=
